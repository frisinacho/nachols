{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": true,
    "redirects": [
      { "source": "/resume/en{,.html}", "destination": "/resume/", "type": 301 },
      { "source": "/resume/es{,.html}", "destination": "/es/resume/", "type": 301 },
      { "source": "/blog{,/**}", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ]
  }
}
